{
  "$schema": "https://opencode.ai/config.json",
  // SemIf (local semantic decisions) is a native server feature now: it ships with
  // the app, vendors llama-server and downloads the pinned model on first use.
  // Configure it with the `semif` block in the global config, or the SemIf tab in
  // the status popover. The legacy `../plugins/semif` dev plugin is superseded.
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
