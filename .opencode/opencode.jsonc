{
  "$schema": "https://opencode.ai/config.json",
  // semif: local SemIf-style semantic decision plugin backed by llama.cpp.
  // mode "auto" loads the sidecar at startup, "lazy" on first use, "off" disables it.
  "plugin": [
    [
      "../plugins/semif",
      {
        "mode": "auto",
        "modelPath": "C:\\Users\\Gabriel\\Desktop\\semif-workspace\\models\\LFM2-350M-Q4_K_M.gguf",
        "serverPath": "C:\\Users\\Gabriel\\Desktop\\semif-workspace\\bin\\b11040\\llama-server.exe",
        "port": 8817,
        "threads": 4
      }
    ]
  ],
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
