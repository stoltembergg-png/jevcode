{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "p0-probe",
  "version": "0.1.0",
  "identifier": "com.p0.probe",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "p0-probe",
        "width": 900,
        "height": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "externalBin": ["binaries/opencode-cli"]
  }
}
