{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode",
  "version": "0.0.0",
  "identifier": "ai.opencode.desktop.v2.dev",
  "build": {
    "frontendDist": "web-stub"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenCode",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/opencode-cli"]
  }
}
